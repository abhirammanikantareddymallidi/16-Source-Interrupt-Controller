# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_rc_corner -name RC_CORNERS -cap_table {../../Cadence/FOUNDRY/digital/90nm/dig/captable/gpdk090.lef.extended.CapTbl} -preRoute_res {1.0} -preRoute_cap {1.0} -preRoute_clkres {0.0} -preRoute_clkcap {0.0} -postRoute_res {1.0} -postRoute_cap {1.0} -postRoute_xcap {1.0} -postRoute_clkres {0.0} -postRoute_clkcap {0.0} -qx_tech_file {../../Cadence/FOUNDRY/digital/90nm/dig/qrc/gpdk090_9l.tch}
create_library_set -name MAX_TIMING -timing {../../Cadence/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_library_set -name MIN_TIMING -timing {../../Cadence/FOUNDRY/digital/90nm/dig/lib/fast.lib}
create_constraint_mode -name SDC_CON -sdc_files {interrupt_output.sdc}
create_delay_corner -name MAX_DELAY -library_set {MAX_TIMING} -rc_corner {RC_CORNERS}
create_delay_corner -name MIN_DELAY -library_set {MIN_TIMING} -rc_corner {RC_CORNERS}
create_analysis_view -name WC -constraint_mode {SDC_CON} -delay_corner {MAX_DELAY}
create_analysis_view -name BC -constraint_mode {SDC_CON} -delay_corner {MIN_DELAY}
set_analysis_view -setup {WC} -hold {BC}
