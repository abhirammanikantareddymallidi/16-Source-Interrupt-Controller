
#
# Mnemonic Maps
#
mmap new -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.active}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.clk}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.cpu_ack}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.cpu_eoi}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.cpu_irq}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.irq[15:0]}]}
	} ]]
waveform hierarchy collapse $id
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.irq_id[3:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.mask[15:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.reset}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.stack_empty}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.stack_full}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_interrupt_controller.trigger_type[15:0]}]}
	} ]]

waveform xview limits 0 176000ps
